# Public browser configuration
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Shared infrastructure
DATABASE_URL=postgresql://wellllai:wellllai@localhost:5432/wellllai
KAFKA_BROKERS=localhost:9092
REDIS_URL=redis://localhost:6379

# Internal HTTP endpoints
KNOWLEDGE_SERVICE_URL=http://localhost:3011
LEARNING_SERVICE_URL=http://localhost:3012
INTERVIEW_SERVICE_URL=http://localhost:3013

# Provider configuration. Put the real value in your local environment, never here.
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-5.6-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_MS=60000

# Knowledge worker tuning
KNOWLEDGE_KAFKA_CLIENT_ID=knowledge-service
KNOWLEDGE_KAFKA_GROUP_ID=knowledge-service-v1
KNOWLEDGE_OUTBOX_POLL_MS=500
KNOWLEDGE_MAX_DOCUMENT_BYTES=15728640

# Application ports
API_GATEWAY_PORT=3001
KNOWLEDGE_SERVICE_PORT=3011
LEARNING_SERVICE_PORT=3012
INTERVIEW_SERVICE_PORT=3013
