{
  "name": "@wellllai/api-gateway",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "nodemon --legacy-watch --signal SIGTERM --delay 500ms --watch src --watch ../../packages/contracts/src --watch ../../packages/contracts/proto --watch ../../packages/platform/src --ext ts,proto --exec \"tsc -b tsconfig.json && node --enable-source-maps dist/main.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/microservices": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@wellllai/contracts": "0.1.0",
    "@wellllai/platform": "0.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "kafkajs": "^2.2.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12"
  }
}
